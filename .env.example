# PRISM-FAS-C-LLM — environment variable NAMES only.
#
# This file is committed. It MUST NEVER contain a real value.
# Copy it to `.env` (git-ignored) and fill the values locally, or export the
# variables from your shell / secret store instead.
#
# Hard rules (C0 frozen, spec §7.2, §23.3):
#   - a secret is read from the environment or a secret store, never from a config
#     file that enters an artifact identity;
#   - a secret is never logged, never written into JSON provenance, never placed in
#     a report, a screenshot or Git;
#   - C0 and every unit/integration test use a mock/replay provider only. No test may
#     incur a live API call or cost.

# --- LLM provider (used from C1 onward; unused in C0) ------------------------
# Google Gemini Developer API key. Leave empty here.
GEMINI_API_KEY=

# --- Compute backends --------------------------------------------------------
# ssh_lab backend target. Private keys are referenced by path and never committed.
PRISM_C_SSH_HOST=
PRISM_C_SSH_USER=
PRISM_C_SSH_KEY_PATH=

# --- Local roots (inherited Version-B convention) ----------------------------
# Machine-specific absolute paths; prefer configs/paths.local.yaml where supported.
PRISM_RAW_ROOT=
PRISM_DATA_ROOT=
PRISM_RUN_ROOT=
PRISM_MODEL_ROOT=
