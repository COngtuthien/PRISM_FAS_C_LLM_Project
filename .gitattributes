# Frozen scientific artifacts must keep LF endings on every platform: a recipe
# bank's identity is a hash over its exact text, and a CRLF checkout would make
# the committed bank differ from the bank the builder reproduces.
assets/recipe_banks/** text eol=lf

# The same rule, for the same reason, applied to every file whose RAW BYTES are
# hashed into a frozen contract identity.
#
# C3_SELECTION_CONTRACT_IDENTITY binds `file_sha256` over the selector
# implementation and its configuration (see
# prism_fas.llm.selection_contract.IMPLEMENTATION_FILES / CONFIG_FILES). With
# core.autocrlf=true a fresh Windows clone would rewrite these to CRLF, every
# hash would move, and the superseding bank-contract lock would stop verifying
# against the code it claims to freeze.
src/prism_fas/recipes/selection.py        text eol=lf
src/prism_fas/recipes/eligibility.py      text eol=lf
src/prism_fas/recipes/arm_schedules.py    text eol=lf
configs/version_c/llm/c3_selection_contract.yaml text eol=lf

# reports/c3/ is deliberately NOT pinned here. The historical preliminary lock
# reports/c3/C3_BANK_LOCK.json was committed before this rule existed and is
# checked out with platform line endings; pinning it now would rewrite the bytes
# of a frozen artifact on the next checkout. Its immutability is proved instead
# by the line-ending-independent hashes recorded in
# reports/c3/v15_selection_contract/C3_PRELIMINARY_LOCK_INTEGRITY.json — the
# canonical body identity, and a SHA-256 over the LF-normalized text.
